# Database — Supabase PostgreSQL
# Find this in: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# JWT — generate strong random values for production
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (database + file storage — same project)
# URL: Supabase dashboard → Project Settings → API → Project URL
# Service role key: Project Settings → API → service_role (keep secret!)
SUPABASE_URL=https://[YOUR-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=sth-files

# Seed credentials — accounts created by `npm run db:seed`
SEED_SUPER_ADMIN_EMAIL=superadmin@srithangam.com
SEED_ADMIN_EMAIL=admin@srithangam.com
SEED_USER_EMAIL=user@srithangam.com
SEED_PASSWORD=Admin@123
